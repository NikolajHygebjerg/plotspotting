{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd app && bash scripts/vercel-build.sh",
  "outputDirectory": "app/build/web",
  "installCommand": "echo \"Flutter install handled in buildCommand\"",
  "rewrites": [
    {
      "source": "/((?!assets/|canvaskit/|icons/|splash/|favicon.png|flutter.js|flutter_bootstrap.js|main.dart.js|manifest.json|version.json|flutter_service_worker.js).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/e/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
