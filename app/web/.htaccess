# Apache: send alle ruter til Flutter (SPA) så /e/friland virker.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Cache statiske assets længe; index.html altid frisk.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|wasm|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|flutter_service_worker\.js|version\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
